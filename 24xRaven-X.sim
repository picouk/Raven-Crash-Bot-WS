//============================================
// 24xRaven X - Premium Anastasia Theme
// Competitive | Elegant | Modern
// Designed for 1v1 Tournament Victory
//============================================

[Theme]
Name=24xRaven X
Author=24xRaven
Version=1.0
Description=Premium competitive theme with elegant dark aesthetics

//============================================
// COLOR PALETTE - Dark Elegant Premium
//============================================
[Colors]
// Primary Colors
Primary=#9D4EDD          // Vibrant Purple
Secondary=#06FFF0        // Cyan Glow
Accent=#FF6B9D           // Soft Red/Pink
Background=#0A0E27       // Deep Dark Blue
Surface=#151B3D          // Dark Surface
Text=#E8E8F5             // Soft White
TextSecondary=#9CA3C7    // Muted Gray-Blue

// UI Elements
MenuBG=#0F1433           // Menu Background
MenuHighlight=#1A2147    // Hover State
Border=#2D3561           // Subtle Borders
Shadow=#000000           // Pure Black Shadow
Glow=#9D4EDD             // Purple Glow

//============================================
// INTRO ANIMATION (6 seconds)
//============================================
[Intro]
Duration=6000
FadeIn=800
FadeOut=600

// Stage 1: Logo Reveal (0-2s)
[Intro.Stage1]
Start=0
Duration=2000
Type=FadeSlide
Element=Logo
From=Bottom
Distance=50
Opacity=0>1
Glow=True
GlowColor=#9D4EDD

// Stage 2: Title Animation (2-4.5s)
[Intro.Stage2]
Start=2000
Duration=2500
Type=TypeWriter
Text=24xRaven
Speed=150
Color=#E8E8F5
Font=Orbitron Bold
Size=72

// X Letter Special Effect
[Intro.XLetter]
Start=3800
Duration=700
Color=#06FFF0
Scale=1.0>1.3>1.0
Glow=True
GlowIntensity=High
Pulse=True

// Stage 3: Subtitle Fade (4.5-6s)
[Intro.Stage3]
Start=4500
Duration=1500
Type=FadeIn
Text=COMPETITIVE EDITION
Color=#9CA3C7
Font=Rajdhani Medium
Size=18
LetterSpacing=4

//============================================
// MAIN MENU DESIGN
//============================================
[MainMenu]
Layout=Vertical
Alignment=Center
Spacing=16
AnimationType=Smooth

// Background
[MainMenu.Background]
Type=Gradient
Color1=#0A0E27
Color2=#151B3D
Angle=135
Overlay=Particles
ParticleColor=#9D4EDD
ParticleOpacity=0.15
ParticleSpeed=Slow

// Logo Position
[MainMenu.Logo]
Position=TopCenter
OffsetY=80
Width=280
Height=120
Glow=True
GlowColor=#9D4EDD
GlowRadius=30

// Title Display
[MainMenu.Title]
Text=24xRaven
Font=Orbitron Bold
Size=56
Color=#E8E8F5
Position=Center
OffsetY=-120
LetterSpacing=2
Shadow=True
ShadowColor=#000000
ShadowBlur=20

[MainMenu.TitleX]
Text=X
Font=Orbitron Bold
Size=56
Color=#06FFF0
Glow=True
GlowColor=#06FFF0
GlowIntensity=Medium

// Menu Items Container
[MainMenu.Container]
Position=Center
Width=400
OffsetY=40
Background=#0F1433
BorderRadius=12
Border=1px
BorderColor=#2D3561
Shadow=True
ShadowBlur=40
ShadowColor=#000000
Padding=32

// Menu Items
[MainMenu.Items]
Font=Rajdhani SemiBold
Size=22
Color=#9CA3C7
Spacing=20
Transition=300ms

[MainMenu.Item.Hover]
Color=#E8E8F5
Background=#1A2147
BorderLeft=3px
BorderColor=#9D4EDD
TranslateX=8
Scale=1.02

[MainMenu.Item.Selected]
Color=#06FFF0
Background=#1A2147
BorderLeft=4px
BorderColor=#06FFF0
Glow=True
GlowColor=#06FFF0

// Menu Item List
[MainMenu.ItemList]
Item1=START GAME
Item2=CONTINUE
Item3=MULTIPLAYER
Item4=OPTIONS
Item5=GALLERY
Item6=CREDITS
Item7=EXIT

// Decorative Elements
[MainMenu.Decoration]
Type=Lines
Position=Sides
Color=#2D3561
Opacity=0.4
Animation=Pulse
AnimationSpeed=3000

//============================================
// SUB MENUS
//============================================
[SubMenu]
Background=#0F1433
BorderRadius=16
Border=1px
BorderColor=#2D3561
Shadow=True
Padding=40
MaxWidth=800
Transition=400ms

[SubMenu.Header]
Font=Orbitron Bold
Size=32
Color=#E8E8F5
BorderBottom=2px
BorderColor=#9D4EDD
PaddingBottom=16
MarginBottom=32

[SubMenu.Content]
Font=Rajdhani Regular
Size=18
Color=#9CA3C7
LineHeight=1.6

//============================================
// BUTTONS DESIGN
//============================================
[Button]
Font=Rajdhani SemiBold
Size=18
Padding=12 32
BorderRadius=8
Transition=250ms
Cursor=Pointer

[Button.Primary]
Background=#9D4EDD
Color=#FFFFFF
Border=None
Shadow=True
ShadowColor=#9D4EDD
ShadowBlur=20

[Button.Primary.Hover]
Background=#B565F2
Scale=1.05
ShadowBlur=30

[Button.Secondary]
Background=Transparent
Color=#06FFF0
Border=2px
BorderColor=#06FFF0

[Button.Secondary.Hover]
Background=#06FFF0
Color=#0A0E27
Glow=True

//============================================
// TRANSITIONS & ANIMATIONS
//============================================
[Transitions]
PageChange=FadeSlide
Duration=500
Easing=EaseInOutCubic

[Animations]
MenuItemHover=Smooth
Duration=300
Easing=EaseOut

[Effects]
Glow=Enabled
GlowIntensity=Medium
Particles=Enabled
ParticleDensity=Low
Blur=Subtle

//============================================
// GAME UI OVERLAY
//============================================
[GameUI]
Style=Minimal
Opacity=0.95
Position=Corners

[GameUI.HealthBar]
Position=TopLeft
Color=#FF6B9D
Background=#1A2147
Border=#2D3561
Height=8
BorderRadius=4
Glow=True

[GameUI.ScoreDisplay]
Position=TopCenter
Font=Orbitron Bold
Size=48
Color=#06FFF0
Glow=True
Shadow=True

//============================================
// LOADING SCREEN
//============================================
[Loading]
Background=#0A0E27
LogoSize=200
LogoGlow=True

[Loading.ProgressBar]
Width=400
Height=4
Background=#1A2147
FillColor=#9D4EDD
BorderRadius=2
Glow=True
GlowColor=#9D4EDD

[Loading.Text]
Font=Rajdhani Medium
Size=16
Color=#9CA3C7
Position=Bottom
OffsetY=-100
Animation=Pulse

//============================================
// SETTINGS MENU
//============================================
[Settings]
Layout=Grid
Columns=2
Gap=24

[Settings.Section]
Background=#151B3D
BorderRadius=12
Padding=24
Border=1px
BorderColor=#2D3561

[Settings.Label]
Font=Rajdhani SemiBold
Size=16
Color=#E8E8F5
MarginBottom=8

[Settings.Slider]
TrackColor=#1A2147
FillColor=#9D4EDD
ThumbColor=#06FFF0
Height=6
BorderRadius=3

[Settings.Toggle]
OffColor=#1A2147
OnColor=#9D4EDD
ThumbColor=#FFFFFF
Width=48
Height=24
BorderRadius=12

//============================================
// GALLERY VIEW
//============================================
[Gallery]
Layout=Grid
Columns=4
Gap=16
Padding=40

[Gallery.Item]
BorderRadius=12
Border=2px
BorderColor=#2D3561
Transition=300ms
Overflow=Hidden

[Gallery.Item.Hover]
BorderColor=#9D4EDD
Scale=1.05
Shadow=True
ShadowColor=#9D4EDD
ShadowBlur=30

//============================================
// CREDITS SCREEN
//============================================
[Credits]
Background=#0A0E27
ScrollSpeed=30
Font=Rajdhani Regular
Size=18
Color=#9CA3C7
LineHeight=2

[Credits.Header]
Font=Orbitron Bold
Size=28
Color=#E8E8F5
MarginTop=40
MarginBottom=20

[Credits.Highlight]
Color=#06FFF0
Font=Rajdhani SemiBold

//============================================
// SOUND EFFECTS MAPPING
//============================================
[Audio]
MenuHover=soft_click.wav
MenuSelect=confirm.wav
MenuBack=back.wav
Transition=whoosh.wav
IntroMusic=intro_theme.mp3
MenuMusic=menu_ambient.mp3

//============================================
// RESPONSIVE DESIGN
//============================================
[Responsive]
MinWidth=1280
MinHeight=720
ScaleMode=Proportional
MaintainAspectRatio=True

//============================================
// PERFORMANCE SETTINGS
//============================================
[Performance]
EnableGlow=True
EnableParticles=True
EnableShadows=True
EnableTransitions=True
TargetFPS=60
OptimizeAnimations=True

//============================================
// ACCESSIBILITY
//============================================
[Accessibility]
HighContrast=Available
FontScaling=Enabled
ReducedMotion=Optional
ColorBlindMode=Available

//============================================
// END OF THEME
//============================================
